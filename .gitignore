# Build output — regenerated by cmake --build, never committed
/build/
/out/

# CMake-generated files (in case CMake is ever run outside /build/)
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
compile_commands.json
Makefile
*.cmake
!CMakeLists.txt

# Compiled objects / binaries (should only ever exist inside /build/)
*.o
*.exe
*.dll
*.a
*.lib
*.pdb
*.ilk
*.log

# IDE / editor
.vscode/
.vs/
.idea/
*.user

# OS cruft
Thumbs.db
.DS_Store